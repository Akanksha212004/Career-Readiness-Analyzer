# Port the Express server listens on
PORT=5000

# MongoDB connection string (local or Atlas). Database name is included in the URI.
MONGODB_URI=mongodb://localhost:27017/career_readiness_analyzer

# Base URL of the ai-service (Python/FastAPI) this backend orchestrates calls to
AI_SERVICE_URL=http://localhost:8000

# Comma-separated list of origins allowed to call this API (your frontend's URL)
ALLOWED_ORIGINS=http://localhost:3000

# Max resume upload size in bytes (default 5MB)
MAX_UPLOAD_SIZE_BYTES=5242880

# Rate limiting: requests allowed per IP per window
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Stricter rate limiting specifically on /api/auth/* (register/login/logout)
# to slow down credential-stuffing / brute-force attempts.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=10

# --- Auth ---
# Secret used to sign JWTs. Use a long, random value in real deployments -
# never commit a real secret here. e.g. generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-in-your-local-.env

# How long an issued JWT stays valid (jsonwebtoken "zeit/ms" string format)
JWT_EXPIRES_IN=7d

# Matching numeric days used for the auth cookie's maxAge
JWT_EXPIRES_IN_DAYS=7

# Whether the auth cookie is marked `secure` (HTTPS-only). MUST be false for
# local http://localhost development, or the browser will refuse to send the
# cookie. Set this to true in any real (HTTPS) deployment.
COOKIE_SECURE=false

# Host/port the FastAPI service binds to
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000

# Comma-separated list of origins allowed to call this service directly
# (should just be the backend's URL in production)
ALLOWED_ORIGINS=http://localhost:5000

# Sentence-transformers model used for semantic similarity matching.
# all-MiniLM-L6-v2 is a good accuracy/speed tradeoff (~90MB, downloads on first run).
SEMANTIC_MODEL_NAME=all-MiniLM-L6-v2

# Minimum fuzzy-match score (0-100) for rapidfuzz to count a resume token
# as matching a required skill when it isn't an exact/lemma match.
FUZZY_MATCH_THRESHOLD=85

# Weight given to fuzzy/exact matching vs semantic similarity when combining
# the two into a single per-skill match score (0-1). 0.5 = equal weight.
FUZZY_WEIGHT=0.5

# Optional: a GitHub personal access token (no scopes required) used only to
# raise the GitHub API rate limit when verifying GitHub links found in
# resumes, from 60 requests/hour (unauthenticated) to 5000/hour. Safe to
# leave blank - verification degrades gracefully to a "rate_limited" status
# per link if the limit is hit.
GITHUB_TOKEN=
